{
  "outputDirectory": "public",
  "functions": {
    "api/assistant.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/pm",
      "destination": "/pm/index.html"
    },
    {
      "source": "/pm/",
      "destination": "/pm/index.html"
    },
    {
      "source": "/((?!pm/).*)",
      "destination": "/index.html"
    }
  ]
}
